# Local development template. All secret values are intentionally empty.
# Copy to .env, generate your own credentials, and keep .env out of Git.
RIPE_ATLAS_BASE_URL=https://atlas.ripe.net/api/v2
RIPE_DEFAULT_MEASUREMENT_ID=1009
RIPE_REQUEST_TIMEOUT=30
RIPE_MAX_RETRIES=3
RIPE_BACKOFF_SECONDS=1.0
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=telecom-data
SPARK_MASTER=local[*]
LOG_LEVEL=INFO
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_DATABASE=telecom
CLICKHOUSE_USER=telecom
CLICKHOUSE_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MONITORING_COUNTRIES=VN,DE,SG,JP,US
# Separate Airflow Compose: use --env-file .env from the repository root.
AIRFLOW_POSTGRES_PASSWORD=
# Set a complete postgresql+psycopg2 DSN for user/database airflow at postgres:5432.
# Its URL-encoded password must match AIRFLOW_POSTGRES_PASSWORD.
AIRFLOW_DATABASE_URL=
AIRFLOW_JWT_SECRET=
# Optional: host directory for the exact historical E2E inputs; not included.
VIQ_E2E_INPUT_DIR=
# Local lab ports bind to loopback by default. Review networking before overriding.
VIQ_BIND_ADDRESS=127.0.0.1
